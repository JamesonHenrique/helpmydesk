{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: the use cases except approving or declining a plan (INV-04). Only listens to events.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-startup",
    "allow-start-ticket",
    "allow-diagnose",
    "allow-open-approval",
    "allow-execute",
    "allow-confirm",
    "allow-make-report",
    "allow-edit-report",
    "allow-save-report",
    "allow-history",
    "allow-settings",
    "allow-system",
    "allow-set-autonomy",
    "allow-set-consent",
    "allow-export-all",
    "allow-erase-all",
    "allow-ai-status",
    "allow-ai-connect",
    "allow-ai-disconnect",
    "allow-ai-classify",
    "allow-open-ai-console",
    "allow-ai-connect-from-clipboard",
    "allow-ai-preview",
    "allow-ai-log"
  ]
}
