{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelpMyDesk",
  "version": "0.1.0",
  "identifier": "io.github.jamesonhenrique.helpmydesk",
  "build": {
    "frontendDist": "../ui/dist/ui/browser",
    "devUrl": "http://localhost:4200"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HelpMyDesk",
        "width": 960,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
