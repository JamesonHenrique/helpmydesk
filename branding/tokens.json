    "fontFamilyMono": { "value": "ui-monospace, 'Cascadia Mono', 'SFMono-Regular', Consolas, monospace", "type": "fontFamily" },
    "bodySize": { "value": "1.0625rem", "type": "dimension" },
    "bodyLineHeight": { "value": 1.55, "type": "number" },
